# Frontend settings (optional). Copy to frontend/.env.local to change them.
# Where the dashboard's server finds the backend API. It is only used on the server; the browser never calls the API directly.
API_BASE_URL=http://localhost:4000

# Sign-in (required: without both of these nobody can get in).
# ADMIN_PASSWORD is the password for the single admin account. Pick a long passphrase and keep it out of git.
ADMIN_PASSWORD=
# AUTH_SECRET signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: the same value as INTERNAL_API_KEY in backend/.env, when the backend uses one.
INTERNAL_API_KEY=
