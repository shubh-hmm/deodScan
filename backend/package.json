{
  "name": "deodscan-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:worker": "tsx scripts/dev.ts --worker",
    "db:dev": "node scripts/dev-postgres.mjs",
    "db:migrate": "tsx packages/db/src/cli-migrate.ts",
    "worker": "tsx worker/src/index.ts",
    "sync": "tsx worker/src/cli.ts",
    "api": "tsx api/src/server.ts",
    "api:dev": "tsx watch api/src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "description": "DEODScan backend: Fastify API, Dune sync worker, and the shared libraries and database code they use."
}
