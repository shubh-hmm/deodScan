# Backend settings. Copy to backend/.env and fill in.
DUNE_API_KEY=
# MongoDB connection string; the database name is the part after the last slash. The default is the local database that `npm run dev` / run.cmd start
# on this PC (port 27018, data in backend/.mongodata). For MongoDB Atlas or a server use e.g. mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/deod_monitor
MONGODB_URI=mongodb://127.0.0.1:27018/deod_monitor
# Only for the one-off copy of the OLD PostgreSQL data into MongoDB (npm run db:copy-from-postgres). Leave empty once you have migrated.
DATABASE_URL=
# Bearer token required for /api/admin/* (sync triggers, address management)
ADMIN_TOKEN=
# Telegram alerts (optional, free). Create a bot with @BotFather and put its token here. TELEGRAM_ACCESS_CODE is the code you give to people: they
# message the bot, send this code to be let in, then choose whether to receive alerts. Pick a long secret code (8+ characters). Never commit this
# file. Leave both empty to switch the bot off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_CODE=
# "Ask DEODScan AI" (optional): OpenAI API key from platform.openai.com (a separate paid account; set a spending limit there). Without it the assistant is off.
# OPENAI_MODEL must be a model your key can use (check with: npx tsx worker/src/cli.ts ask-check). ASK_DAILY_LIMIT = most questions per UTC day.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ASK_DAILY_LIMIT=100
# Optional shared key: when set, the API answers only requests carrying it (header x-internal-key). The dashboard sends it from frontend/.env.local
# (INTERNAL_API_KEY, same value). Use a long random string on any server that is reachable from the internet.
INTERNAL_API_KEY=
# Dashboard "Update today" button (spends Dune credits). Set to false on a public server.
REFRESH_TODAY_ENABLED=true
# How many times per UTC day "Update today" may be used (each use costs about 0.4 to 1.4 Dune credits), and the minimum minutes between two uses.
REFRESH_TODAY_MAX_PER_DAY=2
REFRESH_TODAY_COOLDOWN_MINUTES=10
# The worker also updates today's data by itself at these UTC times (default twice a day). These are extra: they do not use the button's budget.
AUTO_UPDATE_TODAY=true
AUTO_UPDATE_TODAY_AT=06:00,14:00
API_PORT=4000
# Only the audit script reads this (the dashboard has its own setting in frontend/.env.example)
API_BASE_URL=http://localhost:4000
# Worker: minutes between checks for a newly completed UTC day (a check with nothing to fetch costs no credits)
SYNC_INTERVAL_MINUTES=60
# Hours to wait after a UTC day ends before fetching it once, so Dune has indexed its last blocks
SYNC_SETTLE_HOURS=2
