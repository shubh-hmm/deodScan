# Backend settings. Copy to backend/.env and fill in.
DUNE_API_KEY=
DATABASE_URL=
# Bearer token required for /api/admin/* (sync triggers, address management)
ADMIN_TOKEN=
# Optional shared key: when set, the API answers only requests carrying it (header x-internal-key). The dashboard sends it from frontend/.env.local
# (INTERNAL_API_KEY, same value). Use a long random string on any server that is reachable from the internet.
INTERNAL_API_KEY=
# Dashboard "Update today" button (spends Dune credits). Set to false on a public server.
REFRESH_TODAY_ENABLED=true
API_PORT=4000
# Only the audit script reads this (the dashboard has its own setting in frontend/.env.example)
API_BASE_URL=http://localhost:4000
# Worker: minutes between checks for a newly completed UTC day (a check with nothing to fetch costs no credits)
SYNC_INTERVAL_MINUTES=60
# Hours to wait after a UTC day ends before fetching it once, so Dune has indexed its last blocks
SYNC_SETTLE_HOURS=2
